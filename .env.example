# Copy to .env, then set only the integrations you use. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
MAX_GEMINI_CALLS_PER_DAY=20
# Local token ceiling across all models; 0 disables this ceiling for a controlled run.
MAX_GEMINI_TOKENS_PER_DAY=150000
MAX_DRAFTS_PER_DAY=3
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_BASE_BRANCH=main
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_API_VERSION=
SITE_URL=https://mkrting.com
# Optional after enabling both products in the Vercel dashboard and obtaining their project-specific script paths.
VERCEL_WEB_ANALYTICS_SCRIPT_PATH=
VERCEL_SPEED_INSIGHTS_SCRIPT_PATH=
